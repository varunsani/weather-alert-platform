# ---------- App ----------
APP_NAME=weather-alert-platform
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------- Database ----------
# Async driver (used by the app at runtime)
DATABASE_URL=postgresql+asyncpg://weather_user:weather_pass@postgres:5432/weather_db
# Sync driver (used by Alembic only)
DATABASE_URL_SYNC=postgresql+psycopg2://weather_user:weather_pass@postgres:5432/weather_db

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- JWT ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- Weather polling (Open-Meteo, no API key required) ----------
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
POLL_INTERVAL_SECONDS=300
WEATHER_CACHE_TTL_SECONDS=300

# ---------- Redis Pub/Sub channel prefix ----------
ALERT_CHANNEL_PREFIX=alerts.location
